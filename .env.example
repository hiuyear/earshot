# Copy to .env and fill in. .env is gitignored.
# Redeem: Fireworks dashboard -> Credits -> Redeem Promo -> FWAI-DAYTONA-7-24-2026
FIREWORKS_API_KEY=

# Optional overrides (defaults verified live against GET /v1/models on the real
# account key — deepseek-v3p1 was the old default and is no longer deployed).
# FIREWORKS_JUDGE_MODEL=accounts/fireworks/models/deepseek-v4-pro
# FIREWORKS_SMALL_MODEL=accounts/fireworks/models/gpt-oss-120b
# FIREWORKS_LARGE_MODEL=accounts/fireworks/models/deepseek-v4-pro
# FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# Phase 2 / sponsor evidence layer.
# ElevenLabs SDK reads ELEVENLABS_API_KEY automatically.
ELEVENLABS_API_KEY=
# Optional ElevenLabs overrides.
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# ELEVENLABS_TIMEOUT_MS=120000

# Braintrust SDK reads BRAINTRUST_API_KEY automatically.
BRAINTRUST_API_KEY=
# Optional Braintrust naming overrides.
# BRAINTRUST_PROJECT=Earshot
# BRAINTRUST_EXPERIMENT=phase-2-demo

# Phase 2 / sandbox layer.
DAYTONA_API_KEY=
# Optional Daytona REST overrides.
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_TOOLBOX_URL=https://proxy.app.daytona.io/toolbox
# DAYTONA_SANDBOX_ID=
# DAYTONA_MAX_TARGETS=1
# DAYTONA_TIMEOUT_SECONDS=120
# DAYTONA_RUN_SCAN=false
